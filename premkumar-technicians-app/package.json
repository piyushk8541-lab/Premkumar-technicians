{
  "name": "premkumar-technicians-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone professional Android application for Prem Kumar Technicians, Darbhanga",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "sync:android": "npm run build && cap sync android",
    "icons": "node scripts/generate-icons.mjs",
    "verify:website": "node scripts/verify-website-unchanged.mjs",
    "test": "node --test tests/app.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
